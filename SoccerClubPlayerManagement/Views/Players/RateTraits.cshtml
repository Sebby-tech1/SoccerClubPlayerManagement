@model SoccerClubPlayerManagement.Models.RatePlayerTraitsViewModel
@using SoccerClubPlayerManagement.Models

@{
    ViewData["Title"] = "Rate Traits";
}

<h1>Rate Traits — @Model.PlayerName</h1>

<form asp-action="RateTraits" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="PlayerId" />
    <input type="hidden" asp-for="PlayerName" />

    <h4 class="mt-4">Physical attributes</h4>
    <div class="row g-3 mb-4" style="max-width: 500px;">
        <div class="col-12">
            <label asp-for="PreferredFoot" class="form-label"></label>
            <select asp-for="PreferredFoot" asp-items="Html.GetEnumSelectList<PreferredFoot>()" class="form-select">
                <option value="">-- Not recorded --</option>
            </select>
            <span asp-validation-for="PreferredFoot" class="text-danger"></span>
        </div>
        <div class="col-6">
            <label asp-for="HeightFeet" class="form-label"></label>
            <input asp-for="HeightFeet" type="number" min="3" max="8" class="form-control" />
            <span asp-validation-for="HeightFeet" class="text-danger"></span>
        </div>
        <div class="col-6">
            <label asp-for="HeightInches" class="form-label"></label>
            <input asp-for="HeightInches" type="number" min="0" max="11" class="form-control" />
            <span asp-validation-for="HeightInches" class="text-danger"></span>
        </div>
    </div>

    <h4>Trait ratings</h4>
    <p class="text-muted">Enter a rating from 1 to 10 for each trait. Leave blank to remove a rating.</p>

    <table class="table" style="max-width: 500px;">
        <thead>
            <tr>
                <th>Trait</th>
                <th style="width: 120px;">Rating (1-10)</th>
            </tr>
        </thead>
        <tbody>
        @for (int i = 0; i < Model.Traits.Count; i++)
        {
            <tr>
                <td>
                    @Model.Traits[i].TraitName
                    <input type="hidden" asp-for="Traits[i].TraitId" />
                    <input type="hidden" asp-for="Traits[i].TraitName" />
                </td>
                <td>
                    <input asp-for="Traits[i].Rating" type="number" min="1" max="10" class="form-control" />
                </td>
            </tr>
        }
        </tbody>
    </table>

    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Details" asp-route-id="@Model.PlayerId" class="btn btn-secondary">Cancel</a>
</form>
