@model SoccerClubPlayerManagement.Models.EditLineupViewModel
@using Microsoft.AspNetCore.Mvc.Rendering
@using SoccerClubPlayerManagement.Models

@{
    ViewData["Title"] = "Edit Lineup";
    var formations = ViewBag.Formations as SelectList;
    var players = ViewBag.Players as List<Player>;
}

<h1>Edit Lineup</h1>

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<form method="get" asp-action="Edit" class="mb-4" style="max-width: 300px;">
    <label class="form-label">Formation</label>
    <select name="formationId" asp-items="formations" class="form-select" onchange="this.form.submit()"></select>
    <p class="form-text">Changing formation clears unsaved slot picks below (saved lineups on a
        different formation are left untouched until you save).</p>
</form>

<form asp-action="Save" method="post">
    <input type="hidden" asp-for="LineupId" />
    <input type="hidden" asp-for="FormationId" />

    <h4>Starting XI</h4>
    <table class="table" style="max-width: 600px;">
        <thead>
            <tr>
                <th style="width: 80px;">Slot</th>
                <th>Player</th>
            </tr>
        </thead>
        <tbody>
        @for (int i = 0; i < Model.Slots.Count; i++)
        {
            <tr>
                <td>
                    <span class="badge bg-secondary">@Model.Slots[i].Label</span>
                    <input type="hidden" asp-for="Slots[i].FormationSlotId" />
                    <input type="hidden" asp-for="Slots[i].Label" />
                    <input type="hidden" asp-for="Slots[i].X" />
                    <input type="hidden" asp-for="Slots[i].Y" />
                </td>
                <td>
                    <select asp-for="Slots[i].PlayerId" class="form-select">
                        <option value="">-- Unassigned --</option>
                        @if (players != null)
                        {
                            @foreach (var p in players)
                            {
                                if (Model.Slots[i].PlayerId == p.PlayerId)
                                {
                                    <option value="@p.PlayerId" selected>@p.FirstName @p.LastName (@p.Position?.Name)</option>
                                }
                                else
                                {
                                    <option value="@p.PlayerId">@p.FirstName @p.LastName (@p.Position?.Name)</option>
                                }
                            }
                        }
                    </select>
                </td>
            </tr>
        }
        </tbody>
    </table>

    <div class="mb-4" style="max-width: 400px;">
        <label asp-for="CaptainPlayerId" class="form-label">Captain</label>
        <select asp-for="CaptainPlayerId" class="form-select">
            <option value="">-- No captain selected --</option>
            @if (players != null)
            {
                @foreach (var p in players)
                {
                    if (Model.CaptainPlayerId == p.PlayerId)
                    {
                        <option value="@p.PlayerId" selected>@p.FirstName @p.LastName</option>
                    }
                    else
                    {
                        <option value="@p.PlayerId">@p.FirstName @p.LastName</option>
                    }
                }
            }
        </select>
        <p class="form-text">Must be one of the 11 players selected above.</p>
    </div>

    <h4>Substitutes</h4>
    <table class="table" style="max-width: 600px;">
        <thead>
            <tr>
                <th style="width: 80px;">Bench</th>
                <th>Player</th>
            </tr>
        </thead>
        <tbody>
        @for (int i = 0; i < Model.Substitutes.Count; i++)
        {
            <tr>
                <td><span class="badge bg-light text-dark">Sub @(i + 1)</span></td>
                <td>
                    <select asp-for="Substitutes[i].PlayerId" class="form-select">
                        <option value="">-- Unassigned --</option>
                        @if (players != null)
                        {
                            @foreach (var p in players)
                            {
                                if (Model.Substitutes[i].PlayerId == p.PlayerId)
                                {
                                    <option value="@p.PlayerId" selected>@p.FirstName @p.LastName (@p.Position?.Name)</option>
                                }
                                else
                                {
                                    <option value="@p.PlayerId">@p.FirstName @p.LastName (@p.Position?.Name)</option>
                                }
                            }
                        }
                    </select>
                </td>
            </tr>
        }
        </tbody>
    </table>

    <button type="submit" class="btn btn-primary">Save Lineup</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
