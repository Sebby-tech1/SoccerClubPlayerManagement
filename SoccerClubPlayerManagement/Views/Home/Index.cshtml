@{
    ViewData["Title"] = "Home";
}

<!-- Hero Section -->
<section class="club-hero home-hero">
    <div class="row align-items-center">

        <div class="col-lg-7">
            <span class="hero-badge">GWP FC CLUB MANAGEMENT</span>

            <h1 class="display-3 mt-3">
                Manage Your Players.<br />
                <span>Build Your Team.</span>
            </h1>

            <p class="hero-text">
                Keep player information organised and easily accessible.
                View player profiles, positions, characteristics and availability
                from one central system.
            </p>

            <div class="hero-buttons">
                <a asp-controller="Players"
                   asp-action="Index"
                   class="btn btn-light btn-lg me-2">
                    View Players
                </a>

                <a asp-controller="Players"
                   asp-action="Create"
                   class="btn btn-outline-light btn-lg">
                    Register Player
                </a>
            </div>
        </div>

        <div class="col-lg-5 text-center">
            <img src="~/images/poster.jpg" alt="GWP FC" class="club-poster" />

            <h3 class="text-white mt-3">Team Management</h3>

            <p class="text-white-50">
                Everything your coaching team needs to manage player information.
            </p>
        </div>

    </div>
</section>


<!-- Quick Statistics -->
<section class="home-stats">

    <div class="row g-4">

        <div class="col-md-3">
            <div class="stat-card">
                <div class="stat-icon">👥</div>
                <h2>35+</h2>
                <p>Players</p>
            </div>
        </div>

        <div class="col-md-3">
            <div class="stat-card">
                <div class="stat-icon">⚽</div>
                <h2>Profiles</h2>
                <p>Player Information</p>
            </div>
        </div>

        <div class="col-md-3">
            <div class="stat-card">
                <div class="stat-icon">📅</div>
                <h2>Availability</h2>
                <p>Training & Matches</p>
            </div>
        </div>

        <div class="col-md-3">
            <div class="stat-card">
                <div class="stat-icon">📱</div>
                <h2>Tablet</h2>
                <p>Friendly Access</p>
            </div>
        </div>

    </div>

</section>


<!-- About the System -->
<section class="home-section">

    <div class="row align-items-center">

        <div class="col-lg-6">
            <span class="section-label">PLAYER MANAGEMENT</span>

            <h2>
                Everything in one place
            </h2>

            <p>
                The Soccer Club Player Profile and Team Management System
                provides the coaching team with a central place to manage
                player information.
            </p>

            <p>
                Instead of relying on physical registration forms,
                WhatsApp messages and memory, coaches can quickly access
                the information they need when preparing for training
                sessions and matches.
            </p>

            <a asp-controller="Players"
               asp-action="Index"
               class="btn btn-primary">
                Explore Players
            </a>
        </div>

        <div class="col-lg-6 mt-4 mt-lg-0">

            <div class="feature-panel">

                <div class="feature-item">
                    <div class="feature-icon">👤</div>
                    <div>
                        <h5>Player Profiles</h5>
                        <p>
                            View player information, photographs,
                            positions, age, height and characteristics.
                        </p>
                    </div>
                </div>

                <div class="feature-item">
                    <div class="feature-icon">🔎</div>
                    <div>
                        <h5>Search & Filter</h5>
                        <p>
                            Quickly find players and filter them
                            according to their playing position.
                        </p>
                    </div>
                </div>

                <div class="feature-item">
                    <div class="feature-icon">📅</div>
                    <div>
                        <h5>Player Availability</h5>
                        <p>
                            Keep track of player availability when
                            planning training sessions and matches.
                        </p>
                    </div>
                </div>

                <div class="feature-item">
                    <div class="feature-icon">📸</div>
                    <div>
                        <h5>Player Photographs</h5>
                        <p>
                            Store player photographs with their
                            profiles for easier identification.
                        </p>
                    </div>
                </div>

            </div>

        </div>

    </div>

</section>


<!-- Call to Action -->
<section class="home-cta">

    <div class="text-center">

        <h2>Ready to manage your team?</h2>

        <p>
            Access your player profiles and keep your team information organised.
        </p>

        <a asp-controller="Players"
           asp-action="Index"
           class="btn btn-light btn-lg">
            View Player Profiles
        </a>

    </div>

</section>